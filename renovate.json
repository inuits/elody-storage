{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Enable packages for requirements.txt",
      "matchManagers": ["pip_requirements", "pep621"],
      "enabled": true
    },
    {
      "description": "Disable specific packages",
      "matchManagers": ["pip_requirements", "pep621"],
      "matchPackageNames": ["AMQPStorm"],
      "enabled": false
    }
  ]
}
